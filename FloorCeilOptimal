class Solution {
    public int[] getFloorAndCeil(int[] nums, int x) 
    {
       //floor : largest element in the array , and smaller /equal than x ;
       int floor=floor(nums,x);
       //ceil : smallest element in the array and greater or equal than x;
              int ceil=ceil(nums,x);
              return new int[]{floor, ceil};
    }

private int floor(int nums[],int x){
int floor = -1;

int low=0;int high=nums.length-1;

while(low<=high){
    int mid=low+(high-low)/2;

    if(nums[mid]<=x){
        floor=nums[mid];
        low=mid+1;
    }else{
        high=mid-1;

    }

}
return floor;
    }   


 private int ceil(int nums[],int x){

int ceil=-1;
int low=0;int high=nums.length-1;

while(low<=high){
    int mid=low+(high-low)/2;

    if(nums[mid]>=x){
        ceil=nums[mid];
          high=mid-1;
    }else{
        low=mid+1;

    }

}return ceil;
    }

}
    

class Solution {
    public int countPrimes(int n) {
        //sieve of eratosthenes : algo to find all prime numbers upto a given limit!
        /** method says : assume all numbers prime , strt from 2 , mark all the multiples of 2 as NON PRIME..similarity for all the numbers...continue until root n. */

        if (n <= 2) {
            return 0;
        }

        boolean[] isPrime = new boolean[n];
        for (int i = 2; i < n; i++) {
            isPrime[i] = true;
        }

        //sieve of eratosthenes :
        for (int i = 2; i * i < n; i++) {
            if (isPrime[i]) {
                for (int j = i * i; j < n; j += i) {
                    isPrime[j] = false;
                }
            }
        }

        int count = 0;
        for (int i = 2; i < n; i++) {
            if (isPrime[i]) {
                count++;
            }
        }

        return count;
    }
}

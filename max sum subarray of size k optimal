class Solution {
	public int maxSubarraySum(int[] arr, int k) {
		int windowSum = 0;
		
		// Calculate the sum of first window :
		for (int i = 0; i<k; i++) {
			windowSum += arr[i];
		}
		
		int maxSum = windowSum;
	//slide the window :-- 	
		for (int i = k; i<arr.length; i++) {
			windowSum=windowSum - arr[i-k]+arr[i];
			
			maxSum=Math.max(windowSum,maxSum);
			
		}return maxSum;
	}
}
